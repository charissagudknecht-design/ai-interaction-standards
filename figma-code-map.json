{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "version": "1.0.0",
  "lastUpdated": "2026-02-02",
  "figmaFileUrl": "",
  "description": "Mapping between Figma design system components and code implementation",
  
  "tokens": {
    "colors": {
      "figmaCollection": "Colors",
      "codeFile": "src/styles/tokens/_colors.scss",
      "mappings": [
        { "figma": "Lavender/100", "scss": "$color-lavender-100", "css": "--color-lavender-100" },
        { "figma": "Lavender/200", "scss": "$color-lavender-200", "css": "--color-lavender-200" },
        { "figma": "Blue/100", "scss": "$color-blue-100", "css": "--bg-blue" },
        { "figma": "Blue/400", "scss": "$color-blue-400", "css": "--bg-cta-blue" },
        { "figma": "Blue/500", "scss": "$color-blue-500", "css": "--text-blue" },
        { "figma": "Green/400", "scss": "$color-green-400", "css": "--schematic-green-400" },
        { "figma": "Red/400", "scss": "$color-red-400", "css": "--bg-cta-red" },
        { "figma": "Yellow/300", "scss": "$color-yellow-300", "css": "--stroke-yellow" },
        { "figma": "Text/Primary", "scss": "$text-primary", "css": "--text-primary" },
        { "figma": "Text/Secondary", "scss": "$text-secondary", "css": "--text-secondary" },
        { "figma": "Background/White", "scss": "$bg-white", "css": "--bg-white" },
        { "figma": "Background/Gray", "scss": "$bg-gray", "css": "--bg-gray" }
      ]
    },
    "typography": {
      "figmaCollection": "Typography",
      "codeFile": "src/styles/tokens/_typography.scss",
      "mappings": [
        { "figma": "Headline/Large", "scss": "$font-size-headline-large", "value": "20px" },
        { "figma": "Headline/Medium", "scss": "$font-size-headline-medium", "value": "18px" },
        { "figma": "Body/Medium", "scss": "$font-size-body-medium", "value": "14px" },
        { "figma": "Action/Medium", "scss": "$font-size-action-medium", "value": "14px" },
        { "figma": "Footnote/Small", "scss": "$font-size-footnote-small", "value": "10px" }
      ]
    },
    "spacing": {
      "figmaCollection": "Spacing",
      "codeFile": "src/styles/tokens/_spacing.scss",
      "mappings": [
        { "figma": "spacing-1", "scss": "$spacing-1", "value": "4px" },
        { "figma": "spacing-2", "scss": "$spacing-2", "value": "8px" },
        { "figma": "spacing-3", "scss": "$spacing-3", "value": "12px" },
        { "figma": "spacing-4", "scss": "$spacing-4", "value": "16px" },
        { "figma": "spacing-6", "scss": "$spacing-6", "value": "24px" },
        { "figma": "spacing-8", "scss": "$spacing-8", "value": "32px" }
      ]
    }
  },

  "components": [
    {
      "figmaName": "Button",
      "figmaNodeId": "",
      "codeLocation": "src/components/Button/Button.tsx",
      "framework": "React",
      "cssClass": ".rw-btn",
      "documentation": "docs/button-components.html",
      "variants": [
        { "figma": "Primary", "code": "variant=\"primary\"", "cssModifier": ".-primary" },
        { "figma": "Secondary", "code": "variant=\"secondary\"", "cssModifier": ".-secondary" },
        { "figma": "Text", "code": "variant=\"text\"", "cssModifier": ".-text" },
        { "figma": "Danger", "code": "variant=\"danger\"", "cssModifier": ".-danger" }
      ],
      "sizes": [
        { "figma": "Large", "code": "size=\"lg\"", "cssModifier": ".-lg" },
        { "figma": "Medium", "code": "size=\"md\"", "cssModifier": ".-md" },
        { "figma": "Small", "code": "size=\"sm\"", "cssModifier": ".-sm" }
      ],
      "states": ["default", "hover", "focus", "active", "disabled"]
    },
    {
      "figmaName": "Switch",
      "figmaNodeId": "",
      "codeLocation": "src/components/Switch/Switch.js",
      "framework": "Web Components",
      "tagName": "rw-switch",
      "cssClass": ".rw-switch",
      "documentation": "docs/switch-components.html",
      "variants": [],
      "states": ["default", "checked", "disabled", "checked-disabled"]
    },
    {
      "figmaName": "Dropdown Menu",
      "figmaNodeId": "",
      "codeLocation": "src/components/DropdownMenu/DropdownMenu.js",
      "framework": "Web Components",
      "tagName": "rw-dropdown-menu",
      "cssClass": ".rw-dropdown-menu",
      "documentation": "docs/dropdown-menu-components.html",
      "variants": [],
      "states": ["closed", "open"]
    },
    {
      "figmaName": "Kebab Menu",
      "figmaNodeId": "",
      "codeLocation": "src/components/DropdownMenu/DropdownMenu.ts",
      "framework": "Web Components",
      "tagName": "rw-dropdown-menu",
      "cssClass": ".rw-kebab",
      "documentation": "docs/dropdown-menu-components.html#dropdown-with-kebab",
      "variants": [{ "name": "trigger", "value": "kebab" }],
      "states": ["closed", "open"]
    },
    {
      "figmaName": "Notification Banner",
      "figmaNodeId": "",
      "codeLocation": "src/components/Notification/Notification.js",
      "framework": "Web Components",
      "tagName": "rw-notification",
      "cssClass": ".rw-notification",
      "documentation": "docs/banner-components.html",
      "variants": [
        { "figma": "Success", "code": "type=\"success\"" },
        { "figma": "Error", "code": "type=\"error\"" },
        { "figma": "Warning", "code": "type=\"warning\"" },
        { "figma": "Info", "code": "type=\"info\"" }
      ],
      "states": ["visible", "dismissed"]
    },
    {
      "figmaName": "Toast",
      "figmaNodeId": "",
      "codeLocation": "src/styles/components/_toast.scss",
      "framework": "CSS",
      "cssClass": ".rw-toast",
      "documentation": "docs/toast-components.html",
      "variants": [
        { "figma": "Success", "cssModifier": ".-success" },
        { "figma": "Error", "cssModifier": ".-error" },
        { "figma": "Warning", "cssModifier": ".-warning" },
        { "figma": "Info", "cssModifier": ".-info" }
      ]
    },
    {
      "figmaName": "Input",
      "figmaNodeId": "",
      "codeLocation": "src/styles/components/_input.scss",
      "framework": "CSS",
      "cssClass": ".rw-input",
      "documentation": "docs/input-components.html",
      "variants": [],
      "states": ["default", "focus", "error", "disabled"]
    },
    {
      "figmaName": "Checkbox",
      "figmaNodeId": "",
      "codeLocation": "src/styles/components/_checkbox.scss",
      "framework": "CSS",
      "cssClass": ".rw-checkbox",
      "documentation": "docs/checkbox-components.html",
      "variants": [],
      "states": ["unchecked", "checked", "disabled"]
    },
    {
      "figmaName": "Radio",
      "figmaNodeId": "",
      "codeLocation": "src/styles/components/_radio.scss",
      "framework": "CSS",
      "cssClass": ".rw-radio",
      "documentation": "docs/radio-components.html",
      "variants": [],
      "states": ["unchecked", "checked", "disabled"]
    },
    {
      "figmaName": "Tab",
      "figmaNodeId": "",
      "codeLocation": "src/styles/components/_tab.scss",
      "framework": "CSS",
      "cssClass": ".rw-tab",
      "documentation": "docs/tab-components.html",
      "variants": [],
      "states": ["inactive", "active", "disabled"]
    },
    {
      "figmaName": "Badge",
      "figmaNodeId": "",
      "codeLocation": "src/styles/components/_badge.scss",
      "framework": "CSS",
      "cssClass": ".rw-badge",
      "documentation": "docs/badge-components.html",
      "variants": [
        { "figma": "Default", "cssModifier": "" },
        { "figma": "Success", "cssModifier": ".-success" },
        { "figma": "Warning", "cssModifier": ".-warning" },
        { "figma": "Error", "cssModifier": ".-error" }
      ]
    },
    {
      "figmaName": "Dialog",
      "figmaNodeId": "",
      "codeLocation": "src/styles/components/_dialog.scss",
      "framework": "CSS",
      "cssClass": ".rw-dialog",
      "documentation": "docs/dialog-components.html",
      "variants": [],
      "states": ["hidden", "visible"]
    },
    {
      "figmaName": "Tooltip",
      "figmaNodeId": "",
      "codeLocation": "src/styles/components/_tooltip.scss",
      "framework": "CSS",
      "cssClass": ".rw-tooltip",
      "documentation": "docs/tooltip-components.html",
      "variants": [
        { "figma": "Top", "cssModifier": ".-top" },
        { "figma": "Bottom", "cssModifier": ".-bottom" },
        { "figma": "Left", "cssModifier": ".-left" },
        { "figma": "Right", "cssModifier": ".-right" }
      ]
    }
  ],

  "syncInstructions": {
    "extractTokens": "Use Figma MCP tool 'get_variable_defs' with the Figma node ID to extract design tokens",
    "updateTokens": "Compare extracted values with SCSS files and update as needed",
    "linkComponent": "Use Figma MCP tool 'add_code_connect_map' to create Figma-to-code links",
    "verifyMapping": "Use 'get_code_connect_map' to verify existing mappings"
  }
}
