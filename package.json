{
  "name": "zen-style",
  "version": "1.0.0",
  "description": "Zen Style Design System - A modern, AI-friendly component library with Web Components and SCSS. Optimized for AI agents with comprehensive documentation.",
  "main": "dist/index.js",
  "module": "dist/index.esm.js",
  "types": "src/types/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.esm.js",
      "require": "./dist/index.js",
      "types": "./src/types/index.d.ts"
    },
    "./styles": "./dist/styles/zen-style.css",
    "./styles/*": "./dist/styles/*"
  },
  "sideEffects": [
    "*.css",
    "*.scss",
    "./src/components/**/*.ts"
  ],
  "scripts": {
    "build": "rollup -c && node scripts/copy-ai-docs.js",
    "build:types": "tsc --emitDeclarationOnly",
    "dev": "npm-run-all --parallel watch:styles serve",
    "build:styles": "sass src/styles/main.scss:dist/styles/zen-style.css --style compressed",
    "watch:styles": "sass src/styles/main.scss:dist/styles/zen-style.css --watch",
    "build:docs": "node scripts/build-docs.js",
    "prebuild:docs": "npm run build:styles",
    "serve": "npx http-server . -p 8081 -c-1",
    "serve:build": "npx http-server build -p 8082",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build -o storybook-static",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:a11y": "jest --testPathPattern=a11y",
    "lint": "eslint src --ext .ts,.js",
    "lint:fix": "eslint src --ext .ts,.js --fix",
    "format": "prettier --write \"src/**/*.{ts,js,scss,css,json}\"",
    "format:check": "prettier --check \"src/**/*.{ts,js,scss,css,json}\"",
    "version": "npm run build && git add dist/",
    "postversion": "git push && git push --tags",
    "prepublishOnly": "npm test && npm run build",
    "release:patch": "npm version patch && npm publish",
    "release:minor": "npm version minor && npm publish",
    "release:major": "npm version major && npm publish",
    "release:beta": "npm version prerelease --preid=beta && npm publish --tag beta",
    "deploy": "npm run build:docs && aws s3 sync build/ s3://zstyle/ --delete && aws cloudfront create-invalidation --distribution-id YOUR_CLOUDFRONT_DIST_ID --paths \"/*\"",
    "deploy:prod": "npm run build:docs && aws s3 sync build/ s3://zstyle/ --delete --cache-control max-age=86400 && aws cloudfront create-invalidation --distribution-id YOUR_CLOUDFRONT_DIST_ID --paths \"/*\"",
    "deploy:staging": "npm run build:docs && aws s3 sync build/ s3://zstyle-staging/ --delete --cache-control max-age=3600 && aws cloudfront create-invalidation --distribution-id YOUR_CLOUDFRONT_DIST_ID --paths \"/*\"",
    "deploy:dry-run": "npm run build:docs && aws s3 sync build/ s3://zstyle/ --dryrun"
  },
  "files": [
    "dist"
  ],
  "keywords": [
    "design-system",
    "components",
    "web-components",
    "ui-library",
    "scss",
    "typescript",
    "ai-friendly",
    "cursor",
    "smacss",
    "bem"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@babel/preset-env": "^7.29.0",
    "@babel/preset-typescript": "^7.28.5",
    "@rollup/plugin-commonjs": "^24.0.0",
    "@rollup/plugin-node-resolve": "^15.0.0",
    "@rollup/plugin-typescript": "^12.3.0",
    "@storybook/addon-a11y": "^8.6.0",
    "@storybook/addon-docs": "^8.6.0",
    "@storybook/addon-links": "^8.6.0",
    "@storybook/blocks": "^8.6.0",
    "@storybook/manager-api": "^8.6.0",
    "@storybook/web-components": "^8.6.0",
    "@storybook/web-components-webpack5": "^8.6.0",
    "@testing-library/jest-dom": "^6.0.0",
    "@types/jest": "^29.0.0",
    "@typescript-eslint/eslint-plugin": "^8.54.0",
    "@typescript-eslint/parser": "^8.54.0",
    "axe-core": "^4.7.0",
    "css-loader": "^7.1.3",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^10.1.8",
    "http-server": "^14.1.1",
    "identity-obj-proxy": "^3.0.0",
    "jest": "^29.0.0",
    "jest-axe": "^8.0.0",
    "jest-environment-jsdom": "^29.0.0",
    "jsdoc": "^4.0.0",
    "lit": "^3.0.0",
    "make-dir-cli": "^3.0.0",
    "npm-run-all": "^4.1.5",
    "prettier": "^3.8.1",
    "rollup": "^2.79.1",
    "rollup-plugin-scss": "^4.0.0",
    "rollup-plugin-terser": "^7.0.2",
    "sass": "^1.58.0",
    "sass-loader": "^16.0.6",
    "storybook": "^8.6.0",
    "style-loader": "^4.0.0",
    "ts-jest": "^29.0.0",
    "tslib": "^2.8.1",
    "typescript": "^5.0.0"
  },
  "dependencies": {
    "babel-loader": "^10.1.1"
  }
}
